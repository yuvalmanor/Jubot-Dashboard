{
  "name": "jubot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:local": "node --env-file-if-exists=.env.local scripts/local-postgres.ts",
    "db:demo": "node --experimental-transform-types --no-warnings --env-file-if-exists=.env.local --import ./scripts/register-alias.mjs scripts/demo-data.ts",
    "db:apply": "node --env-file-if-exists=.env.production.local scripts/apply-sql.ts",
    "db:census": "node --experimental-transform-types --no-warnings --env-file-if-exists=.env.production.local scripts/ledger-census.ts",
    "sheet:refresh": "node --experimental-transform-types --no-warnings --env-file-if-exists=.env.production.local --import ./scripts/register-alias.mjs scripts/sheet-refresh.ts"
  },
  "dependencies": {
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
