# Copy to .env.local for development. Never commit the filled-in version.

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials).
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The two household accounts, comma separated. Anything else is refused.
JUBOT_ALLOWED_EMAILS=yuval@example.com,eden@example.com

# Postgres (Neon or Supabase free tier). Pooled connection string.
DATABASE_URL=

# Set to "disable" only for a local Postgres without TLS.
# DATABASE_SSL=disable
